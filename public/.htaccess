# Cyber Life: Apache / LiteSpeed settings for shared hosting.
# Copied into the build output; harmless where a directive isn't supported.

# Serve the Blender building models with the right type
AddType model/gltf-binary .glb
AddType application/javascript .js .mjs

# Compress text assets
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript model/gltf-binary
</IfModule>

# Hashed JS/CSS can be cached for a long time; models and the page refresh daily
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType model/gltf-binary "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# No directory listings
Options -Indexes
